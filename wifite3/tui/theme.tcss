/* Wifite3 — terminal palette inspired by the classic Wifite2 output */

Screen {
    background: ansi_default;
    color: ansi_default;
}

Header {
    background: ansi_default;
    color: ansi_cyan;
    text-style: bold;
}

Header > .header--title {
    color: ansi_cyan;
}

Footer {
    background: ansi_default;
    color: ansi_bright_black;
}

Footer > .footer--key {
    background: ansi_black;
    color: ansi_cyan;
}

Footer > .footer--description {
    color: ansi_bright_white;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 38;
    min-width: 32;
    max-width: 44;
    height: 1fr;
    background: ansi_default;
    border-right: solid ansi_bright_black;
    padding: 0 1;
}

#sidebar-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#sidebar-actions {
    height: auto;
    dock: bottom;
    background: ansi_default;
    border-top: solid ansi_bright_black;
    padding-top: 1;
}

#logo {
    color: ansi_cyan;
    text-style: bold;
    padding-top: 1;
    height: 2;
}

#tagline {
    color: ansi_bright_black;
    height: 2;
    margin-bottom: 1;
}

.section-title {
    color: ansi_cyan;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.field-label {
    color: ansi_bright_black;
    margin-top: 1;
    height: 1;
}

.hint {
    color: ansi_bright_black;
    height: auto;
    margin-bottom: 1;
}

#adapter-info {
    color: ansi_bright_white;
    height: auto;
    padding: 1 0;
}

#status {
    color: ansi_bright_black;
    height: auto;
    min-height: 2;
    padding-top: 1;
    border-top: dashed ansi_bright_black;
    margin-top: 1;
}

#main {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#stats {
    height: 3;
    background: ansi_default;
    color: ansi_default;
    padding: 0 1;
    border: solid ansi_bright_black;
    margin-bottom: 0;
}

#toolbar {
    height: 3;
    margin-top: 1;
}

#toolbar Input {
    width: 1fr;
}

#toolbar Button {
    margin-left: 1;
    min-width: 22;
}

#targets {
    height: 1fr;
    border: solid ansi_bright_black;
    background: ansi_default;
}

#detail-wrap {
    height: 9;
    border: solid ansi_bright_black;
    background: ansi_default;
    padding: 0 1;
    margin-top: 1;
}

#detail {
    height: auto;
}

#activity {
    height: 1;
    color: ansi_bright_black;
}

Button {
    background: ansi_black;
    color: ansi_default;
    border: none;
    height: 3;
    content-align: center middle;
    text-align: center;
}

Button:hover {
    background: ansi_bright_black;
}

Button.-primary {
    background: ansi_blue;
    color: ansi_bright_white;
}

Button.-primary:hover {
    background: ansi_bright_blue;
}

Button.-success {
    background: ansi_green;
    color: ansi_bright_white;
}

Button.-success:hover {
    background: ansi_bright_green;
}

Button.-warning {
    background: ansi_yellow;
    color: ansi_bright_white;
}

Button.-error {
    background: ansi_red;
    color: ansi_bright_white;
}

Button:disabled {
    background: ansi_black;
    color: ansi_bright_black;
}

#sidebar Button {
    width: 100%;
    margin-top: 1;
}

Input {
    background: ansi_default;
    border: none;
    color: ansi_default;
}

Input:focus {
    background: ansi_black;
    border: tall ansi_cyan;
}

Select {
    background: ansi_default;
    border: none;
}

Select:focus {
    border: tall ansi_cyan;
}

Checkbox {
    background: transparent;
}

DataTable {
    background: ansi_default;
}

DataTable > .datatable--header {
    background: ansi_default;
    color: ansi_cyan;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: ansi_blue;
    color: ansi_bright_white;
}

DataTable > .datatable--even-row {
    background: ansi_default;
}

DataTable > .datatable--odd-row {
    background: ansi_default;
}

ModalScreen {
    align: center middle;
    background: #000000 70%;
}

#confirm-dialog,
#input-dialog {
    width: 66;
    height: auto;
    background: ansi_default;
    border: thick ansi_cyan;
    padding: 1 2;
}

#confirm-label,
#input-label {
    color: ansi_default;
    height: auto;
    margin-bottom: 1;
}

#details-dialog {
    width: 84;
    height: auto;
    max-height: 90%;
    background: ansi_default;
    border: thick ansi_cyan;
    padding: 1 2;
}

#details-text {
    height: auto;
    margin-bottom: 1;
}

#details-clients {
    height: auto;
    max-height: 14;
    border: solid ansi_bright_black;
    margin-top: 1;
}

#details-close {
    width: 20;
    margin-top: 1;
}

#help-dialog {
    width: 88;
    height: auto;
    max-height: 90%;
    background: ansi_default;
    border: thick ansi_cyan;
    padding: 1 2;
}

#help-text {
    height: auto;
}

#help-close {
    width: 20;
    margin-top: 1;
}

.dialog-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-left: 1;
    min-width: 14;
}

#attack-wrap {
    height: 1fr;
    padding: 0 1;
}

#attack-head {
    height: 8;
    border: solid ansi_bright_black;
    background: ansi_default;
    padding: 0 1;
    margin-bottom: 1;
}

#attack-title {
    color: ansi_cyan;
    text-style: bold;
    height: 1;
}

#attack-subtitle {
    color: ansi_bright_black;
    height: 1;
}

#attack-progress {
    height: 1;
    margin-top: 1;
}

#attack-middle {
    height: 1fr;
}

#attack-targets-wrap {
    width: 2fr;
    border: solid ansi_bright_black;
    background: ansi_default;
    padding: 0 1;
    margin-right: 1;
}

#attack-targets {
    height: 1fr;
}

#attack-log-wrap {
    width: 3fr;
    border: solid ansi_bright_black;
    background: ansi_default;
    padding: 0 1;
}

#attack-log {
    height: 1fr;
}

#doctor-wrap {
    height: 1fr;
    padding: 1 2;
}

#doctor-title {
    color: ansi_cyan;
    text-style: bold;
    height: 2;
}

#doctor-summary {
    height: auto;
    min-height: 2;
    color: ansi_bright_white;
    margin-bottom: 1;
}

#doctor-table {
    height: 1fr;
    border: solid ansi_bright_black;
}
